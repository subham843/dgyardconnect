# Copy to supabase/.env (gitignored) before: npm run deploy:supabase

# --- CLI only (required on Windows for secrets + functions deploy) ---
# Dashboard -> Account -> Access Tokens -> Generate new token
# Do NOT commit this file. ACCESS_TOKEN is NOT uploaded to Edge Functions.
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# --- Edge Function secrets (deploy script uploads as FIREBASE_PROJECT_ID + JWT_SECRET) ---
# JWT Secret: Dashboard -> Project Settings -> API -> JWT Secret (not anon/publishable key)
# Keep the key name below; deploy maps it to remote secret JWT_SECRET (SUPABASE_* is reserved by CLI).
FIREBASE_PROJECT_ID=dgyard-connect
SUPABASE_JWT_SECRET=your_jwt_secret_from_dashboard

# --- Shop Razorpay (Edge Function shop-razorpay) ---
# Same keys as Firebase Functions / Razorpay Dashboard
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=xxxxxxxx

# --- Free AI text assist (deploy script uploads if set below) ---
# GROQ_API_KEY=gsk_...        # https://console.groq.com — free
# GEMINI_API_KEY=AIza... or AQ... from Google AI Studio / Cloud — free tier
# OPENAI_API_KEY=sk-proj-...  # optional paid fallback
# TEXT_AI_PROVIDER=auto       # auto | groq | gemini | openai
