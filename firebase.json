      },
      {
        "source": "/category/home-automation",
        "destination": "/store/category/smart-home-automation",
        "type": 301
      },
      {
        "source": "/securing-your-world-the-power-of-professional-cctv-services",
        "destination": "/services",
        "type": 301
      },
      {
        "source": "/transforming-houses-into-smart-homes-the-power-of-home-automation",
