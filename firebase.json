      },
      {
        "source": "/product/2-4mp-ir-bullet-camera-cp-plus",
        "destination": "/product/2-4mp-ir-bullet-camera-20mtr",
        "type": 301
      },
      {
        "source": "/product/cp-plus-2-camera-set",
