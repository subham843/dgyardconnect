{
  "name": "dgyardconnect-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for DG Yard Connect",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase deploy --only functions"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "razorpay": "^2.9.2",
    "twilio": "^5.0.0",
    "@sendgrid/mail": "^8.1.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "typescript": "^5.0.0"
  },
  "private": true
}
